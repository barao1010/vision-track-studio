#pragma once
#include <string>
struct QByteArray { std::string s; const char *constData() const { return s.c_str(); } };
struct QString {
 std::string s;
 QString()=default; QString(const char *value):s(value){}
 bool isEmpty()const{return s.empty();}
 bool operator==(const QString &other)const{return s==other.s;}
 QByteArray toUtf8()const{return {s};}
};
